# انسخ هذا الملف إلى .env وعدّل القيم — لا يُرفع ملف .env إلى المستودع.

# بيئة التشغيل: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------
# قاعدة البيانات — Supabase (المسار المعتمد حاليًا)
# لوحة التحكم → Connect → Session pooler (أو Direct)
# شغّل مع: ?sslmode=require
# مثال:
# postgresql://postgres.xxxxxx:[PASSWORD]@aws-1.pooler.supabase.com:5432/postgres?sslmode=require
# ------------------------------------------------------------------
DATABASE_URL=

# دور PostgreSQL الذي يُنفَّذ فيه كل استعلام تطبيقي بعد SET LOCAL ROLE.
# يُنشأ تلقائيًا في db/migrations (راجع docs/08-supabase-setup.md).
DB_CLIENT_ROLE=app_client

# سرّ الجلسات — استبدل القيمة بسلسلة عشوائية 32 حرفًا على الأقل
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ------------------------------------------------------------------
# تطوير محلي بديل (اختياري): docker compose up -d
# يُستخدم فقط عند العمل بدون Supabase.
# ------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_dev

# ------------------------------------------------------------------
# يُضاف لاحقًا بعد POC-1 / POC-2 — لا تضع رموز OAuth هنا أبدًا.
# رموز التكامل تُخزَّن في مخزن أسرار الخادم فقط.
# ------------------------------------------------------------------
# AUDIO_STORAGE_BUCKET=
# GOOGLE_OAUTH_CLIENT_ID=

# ------------------------------------------------------------------
# مزوّد البيانات الحالي (مؤقت): ملفات JSON محلية
# json = ملفات محلية (الافتراضي) | postgres = Supabase بعد تنفيذ docs/08
# التبديل لاحقًا لا يحتاج تغيير كود الصفحات — راجع docs/09-local-json-storage.md
# ------------------------------------------------------------------
DATA_PROVIDER=json
JSON_DATA_DIR=src/data
JSON_RUNTIME_DIR=data/runtime
