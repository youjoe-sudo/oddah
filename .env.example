# انسخ هذا الملف إلى .env وعدّل القيم — لا يُرفع ملف .env إلى المستودع.

# بيئة التشغيل: development | test | production
NODE_ENV=development

# اتصال قاعدة البيانات (يُقرأ من الخادم فقط، لا يظهر للمتصفح أبدًا)
DATABASE_URL=postgresql://app:app@localhost:5432/app_dev

# سرّ الجلسات — استبدل القيمة بسلسلة عشوائية 32 حرفًا على الأقل
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# منفذ PostgreSQL للحاوية
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_dev

# --- يُضاف لاحقًا بعد POC-1 (الصوتيات) ---
# AUDIO_STORAGE_BUCKET=
# AUDIO_MAX_UPLOAD_MB=

# --- يُضاف لاحقًا بعد POC-2 (YouTube) ---
# لا تُضع رموز OAuth هنا أبدًا: تُخزَّن في مخزن الأسرار الخاص بالخادم.
# GOOGLE_OAUTH_CLIENT_ID=
